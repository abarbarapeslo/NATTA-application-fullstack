rules_version = '2';

// Firebase Storage security rules for NATTA Mobile.
//
// Publish with the Firebase CLI:
//   firebase deploy --only storage
// or paste into Firebase Console → Storage → Rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile avatars: avatars/{uid}/avatar.jpg
    // - Any signed-in user can read avatars (so they show across the app).
    // - Only the owner can upload/replace their own avatar.
    // - Limit to images under 5 MB.
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
