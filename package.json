    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.13.5",
      "fast-uri": ">=3.1.2",
      "protobufjs": ">=7.5.5",
      "tar": ">=7.5.11",
      "undici": ">=6.24.0",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "postcss": ">=8.5.10",
      "path-to-regexp": ">=0.1.13",
      "express>path-to-regexp": "0.1.13",
      "shell-quote": ">=1.8.4",
      "node-forge": ">=1.4.0",
      "brace-expansion@^2.0.0": "^2.0.3",
      "yaml": ">=2.8.3",
      "uuid": ">=14.0.0",
      "qs": ">=6.14.2",
      "esbuild": ">=0.25.0",
      "@xmldom/xmldom": ">=0.8.13",
      "minimatch@^3.0.0": "3.1.4",
      "minimatch@^9.0.0": "9.0.7",
      "minimatch@^10.0.0": "10.2.3",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^3.0.0": "3.0.2",
      "picomatch@^4.0.0": "4.0.4",
      "vite": ">=6.4.2",
      "ajv@^6.0.0": "6.14.0",
      "ajv@^8.0.0": "8.18.0",
      "brace-expansion@^1.0.0": "1.1.13"
